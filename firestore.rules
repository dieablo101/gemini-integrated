rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access for Observatory live stream & telemetry
    // Admin SDK (local Python daemon) bypasses security rules to publish updates
    match /observatory/{docId} {
      allow read: if true;
      allow write: if false;

      match /{subCollection=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Default deny for all other internal/vault collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
